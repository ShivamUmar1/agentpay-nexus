# AgentPay Nexus - Environment Configuration
# Copy this file to .env and configure your credentials.

# --- Application Configuration ---
APP_NAME="AgentPay Nexus"
APP_ENV="production"
DEBUG=false
APP_BASE_URL="http://localhost:5173"
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# --- Database Storage Engine ---
# Supports Supabase PostgreSQL (production) or local SQLite fallback
DATABASE_URL="sqlite:///./agentpay.db"
# For Supabase PostgreSQL, use:
# DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# --- Supabase Auth & Database (Optional) ---
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# --- AI Orchestration Providers ---
# Gemini API is preferred; fallback deterministic intelligence engine activates if keys omitted
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# OpenAI API Adapter (Alternative)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# --- Official PayPal Integration ---
# Obtain from https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_MODE="sandbox" # "sandbox" or "live"
PAYPAL_API_BASE="https://api-m.sandbox.paypal.com"

# --- Public Frontend Variables (Vite) ---
VITE_API_BASE_URL=""
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
VITE_PAYPAL_CLIENT_ID=""
